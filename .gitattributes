# Project text: normalize to LF in the repository and working tree
* text=auto eol=lf

# Binary formats (archive copies are overridden by the LFS rules below)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.svgz binary
*.pdf binary
*.zip binary
*.psd binary

# Archive and archived scrapers: store byte-exact so recorded checksums keep matching
resources/** -text
tools/archive/** -text

# Archive media and other binaries: Git LFS (several files exceed 100 MB)
resources/**/*.psd filter=lfs diff=lfs merge=lfs -text
resources/**/*.png filter=lfs diff=lfs merge=lfs -text
resources/**/*.gif filter=lfs diff=lfs merge=lfs -text
resources/**/*.jpg filter=lfs diff=lfs merge=lfs -text
resources/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
resources/**/*.webp filter=lfs diff=lfs merge=lfs -text
resources/**/*.ico filter=lfs diff=lfs merge=lfs -text
resources/**/*.ogg filter=lfs diff=lfs merge=lfs -text
resources/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
resources/**/*.wav filter=lfs diff=lfs merge=lfs -text
resources/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
resources/**/*.webm filter=lfs diff=lfs merge=lfs -text
