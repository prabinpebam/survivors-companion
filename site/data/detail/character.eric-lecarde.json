label":"Cooldown","cells":[["-5%"]]}]}],"sections":[{"id":"unlocking","title":"Unlocking","blocks":[{"k":"p","c":["Eric Lecarde can be unlocked by evolving the ",{"i":"Sprite-Javelin.png","w":24,"h":24,"r":"weapon:javelin"}," ",{"t":"Javelin","r":"weapon:javelin"},". He needs to be purchased for ",{"i":"Sprite-Gold_Coin.png","w":10,"h":10}," 500, which scales with other characters purchased."]},{"k":"p","c":["Alternatively, Eric can be unlocked in the ",{"i":"Sprite-Forbidden_Scrolls_of_Morbane.png","w":16,"h":16,"r":"relic:forbidden-scrolls-of-morbane"}," ",{"t":"Forbidden Scrolls of Morbane","r":"relic:forbidden-scrolls-of-morbane"}," by casting the spell \"lecardigan\"."]}],"subs":[]},{"id":"passive-bonuses","title":"Passive bonuses","blocks":[{"k":"p","c":["Eric Lecarde starts with +20% ",{"i":"Sprite-Move_Speed.png","w":24,"h":24,"r":"powerup:move-speed"}," ",{"t":"Move Speed","r":"powerup:move-speed"},", +20% ",{"i":"Sprite-Might.png","w":18,"h":24,"r":"powerup:might"}," ",{"t":"Might","r":"powerup:might"},", +20% ",{"i":"Sprite-Speed.png","w":24,"h":24,"r":"powerup:speed"}," ",{"t":"Speed","r":"powerup:speed"},", +20% ",{"i":"Sprite-Area.png","w":22,"h":24,"r":"powerup:area"}," ",{"t":"Area","r":"powerup:area"},", and -5% ",{"i":"Sprite-Cooldown.png","w":24,"h":24,"r":"powerup:cooldown"}," ",{"t":"Cooldown","r":"powerup:cooldown"},"."]},{"k":"p","c":["When Eric Lecarde's health reaches below 20%, he triggers ",{"i":"Sprite-Burning_Alcarde.png","w":24,"h":21,"r":"weapon:burning-alcarde"}," ",{"t":"Burning Alcarde","r":"weapon:burning-alcarde"},", becoming invulnerable for 20 seconds, gaining -20% Cooldown, and a flame aura that deals damage to surrounding enemies. This skill may only be activated again after recovering all HP. Receiving fatal damage resulting in a game-over will not trigger the skill."]},{"k":"p","c":["He can find special Ode to Castlevania pickups from light sources."]}],"subs":[]},{"id":"gallery","title":"Gallery","blocks":[{"k":"gallery","i