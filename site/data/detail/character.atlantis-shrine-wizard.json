{"ref":"character:atlantis-shrine-wizard","lead":[{"k":"p","c":[{"i":"Animated-Alucard.gif","w":40,"h":34}]},{"k":"p","c":["DLC Content (Ode to Castlevania)"]},{"k":"p","c":["This article primarily features content only available in DLC, which may not be available in all copies of the game."]},{"k":"p","c":["Atlantis Shrine Wizard is a secret playable character introduced in the 2025 update of the Ode to Castlevania DLC of Vampire Survivors. His starting weapons are the ",{"i":"Sprite-Hydro_Storm.png","w":22,"h":24,"r":"weapon:hydro-storm"}," ",{"t":"Hydro Storm","r":"weapon:hydro-storm"}," and a hidden ",{"i":"Sprite-Acquazzone.png","w":24,"h":24,"r":"weapon:acquazzone"}," ",{"t":"Acquazzone","r":"weapon:acquazzone"},"."]}],"infobox":[{"title":"Character","rows":[{"label":"Release","cells":[["28 October 2025 (Update)"]]},{"label":"Character ID","cells":[["TP_WATERMAGICIAN"]]},{"label":"Skin ID","cells":[["DEFAULT"]]},{"label":"Controller","cells":[["TP_WaterMagician_Character"]]},{"label":"Starting weapon","cells":[[{"i":"Sprite-Hydro_Storm.png","w":15,"h":16,"r":"weapon:hydro-storm"}," ",{"t":"Hydro Storm","r":"weapon:hydro-storm"}]]},{"label":"Hidden weapon","cells":[[{"i":"Sprite-Acquazzone.png","w":16,"h":16,"r":"weapon:acquazzone"}," ",{"t":"Acquazzone","r":"weapon:acquazzone"}]]},{"label":"Unlocked by","cells":[["Combine holy liquids in a sunken city"]]},{"label":"Cost","cells":[[{"i":"Sprite-Gold_Coin.png","w":10,"h":10}," 5,000"]]},{"label":"Secret","cells":[["Yes"]]},{"label":"Ignores walls","cells":[["No"]]},{"label":"Theme","cells":[[{"i":"Music-Ode_to_Castlevania-Evelyn_Lark.png","w":20,"h":20}," \"Discolored Wall - Vampire Survivors\""]]}]},{"title":"Initial stats","rows":[{"label":"Max Health","cells":[["100"]]},{"label":"Move Speed","cells":[["+40%"]]},{"label":"Duration","cells":[["+40%"]]},{"label":"Reroll","cells":[["+5"]]},{"label":"Skip","cells":[["+5"]]},{"label":"Banish","cells":[["+5"]]}]}],"sections":[{"id":"unlocking","title":"Unlocking","b