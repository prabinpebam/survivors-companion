{"ref":"relic:joker-disk","lead":[{"k":"p","c":[{"i":"Animated-Jimbo.gif","w":40,"h":42}]},{"k":"p","c":["DLC Content (Ante Chamber)"]},{"k":"p","c":["This article primarily features content only available in DLC, which may not be available in all copies of the game."]},{"k":"p","c":["The Joker Disk is a relic located in ",{"t":"Moongolow","r":"stage:moongolow"},". Once collected, it allows entrance to the ",{"t":"Ante Chamber","r":"stage:ante-chamber-stage"}," stage."]}],"infobox":[{"title":"Relic","rows":[{"label":"Release","cells":[["28 October 2025 (Update)"]]},{"label":"ID","cells":[["RELIC_LEM_DISK"]]},{"label":"Effects","cells":[["Permanently unlocks the ",{"t":"Ante Chamber","r":"stage:ante-chamber-stage"}," stage."]]},{"label":"Location","cells":[["Found due west of ",{"t":"Moongolow","r":"stage:moongolow"}," and purchasable from Xanthia."]]}]}],"sections":[{"id":"obtaining","title":"Obtaining","blocks":[{"k":"p","c":["The Joker Disk can be purchased for ",{"i":"Sprite-Gold_Coin.png","w":10,"h":10}," 50,000 from ",{"i":"Sprite-Xanthia.png","w":14,"h":24}," Xanthia (the merchant who usually appears in Planar Bazaar), who can be found on the left side of Moongolow."]},{"k":"p","c":["Alternatively, the Joker Disk can be unlocked in the ",{"i":"Sprite-Forbidden_Scrolls_of_Morbane.png","w":16,"h":16,"r":"relic:forbidden-scrolls-of-morbane"}," ",{"t":"Forbidden Scrolls of Morbane","r":"relic:forbidden-scrolls-of-morbane"}," by casting the spell \"differenttypeofstake\"."]}],"subs":[]},{"id":"update-history","title":"Update history","blocks":[{"k":"p","c":["This information has been manually compiled. Some updates may not be included yet."]},{"k":"ul","items":[{"c":["update 28 October 2025 (Update):"],"sub":{"k":"ul","items":[{"c":["Added to game."]}]}}]}],"subs":[]}]}