lpaese","r":"character:antonio-belpaese"}," lookalike, has the same starting stats and passive as ",{"i":"Sprite-Trevor_Belmont.png","w":24,"h":24,"r":"character:trevor-belmont"}," ",{"t":"Trevor Belmont","r":"character:trevor-belmont"}," ",{"i":"Sprite-DLCBadge-OdeToCastlevania.png","w":12,"h":12,"a":"This content requires the Ode to Castlevania DLC to access"},"."]},{"k":"ul","items":[{"c":["Fake Trevor starts with +20% ",{"i":"Sprite-Move_Speed.png","w":24,"h":24,"r":"powerup:move-speed"}," ",{"t":"Move Speed","r":"powerup:move-speed"}," and an extra ",{"i":"Sprite-Beginning_(X).png","w":17,"h":24,"r":"arcana:beginning-x"}," ",{"t":"Beginning (X)","r":"arcana:beginning-x"},". Fake Trevor also gets +1 ",{"i":"Sprite-Amount.png","w":24,"h":24,"r":"powerup:amount"}," ",{"t":"Amount","r":"powerup:amount"}," every 10 Levels, with a max of +3."]}]},{"k":"p","c":["Fake Sypha, the ",{"i":"Sprite-Imelda_Belpaese.png","w":24,"h":24,"r":"character:imelda-belpaese"}," ",{"t":"Imelda Belpaese","r":"character:imelda-belpaese"}," lookalike, has the same starting stats and passive as ",{"i":"Sprite-Sypha_Belnades.png","w":22,"h":24,"r":"character:sypha-belnades"}," ",{"t":"Sypha Belnades","r":"character:sypha-belnades"}," ",{"i":"Sprite-DLCBadge-OdeToCastlevania.png","w":12,"h":12,"a":"This content requires the Ode to Castlevania DLC to access"},"."]},{"k":"ul","items":[{"c":["Fake Sypha starts with +40% ",{"i":"Sprite-Move_Speed.png","w":24,"h":24,"r":"powerup:move-speed"}," ",{"t":"Move Speed","r":"powerup:move-speed"}," and ",{"i":"Sprite-Duration.png","w":24,"h":24,"r":"powerup:duration"}," ",{"t":"Duration","r":"powerup:duration"},", +10 ",{"i":"Sprite-Reroll.png","w":22,"h":24,"r":"powerup:reroll"}," ",{"t":"Reroll","r":"powerup:reroll"},", ",{"i":"Sprite-Skip.png","w":24,"h":24,"r":"powerup:skip"}," ",{"t":"Skip","r":"powerup:skip"},", and ",{"i":"Sprite-Banish.png","w":24,"h":21,"r":"powerup:banish"}," ",{"t":"Banish","r":"powerup:banish"},", and an extra ",{"i":"Sprite-