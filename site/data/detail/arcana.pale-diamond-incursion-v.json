on:iron-ball"}," ",{"t":"Iron Ball","r":"weapon:iron-ball"}," ",{"i":"Sprite-DLCBadge-OdeToCastlevania.png","w":12,"h":12,"a":"This content requires the Ode to Castlevania DLC to access"}," and ",{"i":"Sprite-Wrecking_Ball.png","w":24,"h":24,"r":"weapon:wrecking-ball"}," ",{"t":"Wrecking Ball","r":"weapon:wrecking-ball"}," ",{"i":"Sprite-DLCBadge-OdeToCastlevania.png","w":12,"h":12,"a":"This content requires the Ode to Castlevania DLC to access"}]},{"c":[{"i":"Sprite-Gros_Michel.png","w":24,"h":24,"r":"weapon:gros-michel"}," ",{"t":"Gros Michel","r":"weapon:gros-michel"}," ",{"i":"Sprite-DLCBadge-AnteChamber.png","w":10,"h":12,"a":"This content requires the Ante Chamber DLC to access"}," and ",{"i":"Sprite-Cavendish.png","w":24,"h":24,"r":"weapon:cavendish"}," ",{"t":"Cavendish","r":"weapon:cavendish"}," ",{"i":"Sprite-DLCBadge-AnteChamber.png","w":10,"h":12,"a":"This content requires the Ante Chamber DLC to access"}]}]}],"subs":[]},{"id":"tips","title":"Tips","blocks":[{"k":"ul","items":[{"c":["The ",{"i":"Sprite-Treasure_Chest_3.png","w":24,"h":23}," Golden Treasure Chests required to unlock this Darkana must be from ",{"i":"Sprite-Zi'Appunta_Belpaese.png","w":24,"h":24,"r":"character:zi-appunta-belpaese"}," ",{"t":"Zi'Appunta Belpaese","r":"character:zi-appunta-belpaese"},"'s exclusive light sources. Treasure Chests modified into Golden Treasure Chests by ",{"i":"Sprite-Call_of_a_Mad_Moon_(XIII).png","w":17,"h":24,"r":"weapon:call-of-a-mad-moon-xiii"}," ",{"t":"Call of a Mad Moon (XIII)","r":"weapon:call-of-a-mad-moon-xiii"}," do not count, and light sources summoned by ",{"i":"Sprite-Greatest_Jubilee.png","w":24,"h":24,"r":"weapon:greatest-jubilee"}," ",{"t":"Greatest Jubilee","r":"weapon:greatest-jubilee"}," or certain Survarot skills cannot spawn as her exclusive ones."],"sub":{"k":"ul","items":[{"c":["An easy way to achieve this is to play on ",{"t":"Il Molise","r":"stage:il-molise"}," with ",{"i":"Sprite-Seventh_Trumpet.png","w":24,"h":24}," Endless Mode enabled, and consistently move while breaking the aforementioned light sources. There are plenty of builds that can make this trivial, but ",{"i":"Sprite-Song_of_Mana.png","w":24,"h":24,"r":"weapon:song-of-mana"}," ",{"t":"Song of Mana","r":"weapon:song-of-mana"}," with ",{"i":"Sprite-Silent_Old_Sanctuary_(XX).png","w":17,"h":24,"r":"arcana:silent-old-sanctuary-xx"}," ",{"t":"Silent Old Sanctuary (XX)","r":"arcana:silent-old-sanctuary-xx"}," with 2 Max Weapons is simple yet effective. Other effective stages include ",{"t":"Moongolow","r":"stage:moongolow"}," and ",{"t":"The Bone Zone","r":"stage:the-bone-zone"},", due to all three stages having incredibly high natural light source spawns."]},{"c":["The player also does not need to open 10 Golden Treasure Chests; they just need to let them appear. This is useful if they player wishes to avoid the clutter or lag from having additional weapons."]}]}},{"c":["This Darkana pairs very well with ",{"i":"Sprite-Chaos_in_the_Dark_Night_(V).png","w":17,"h":24,"r":"arcana:chaos-in-the-dark-night-v"}," ",{"t":"Chaos in the Dark Night (V)","r":"arcana:chaos-in-the-dark-night-v"}," and ",{"i":"Sprite-Hidden_Anathema_(III).png","w":17,"h":24,"r":"arcana:hidden-anathema-iii"}," ",{"t":"Hidden Anathema (III)","r":"arcana:hidden-anathema-iii"},", as both cards provide ",{"i":"Sprite-Speed.png","w":24,"h":24,"r":"powerup:speed"}," ",{"t":"Speed","r":"powerup:speed"},"."],"sub":{"k":"ul","items":[{"c":["For the same reason, characters with uncapped scaling ",{"i":"Sprite-Speed.png","w":24,"h":24,"r":"powerup:speed"}," ",{"t":"Speed","r":"powerup:speed"},", such as ",{"i":"Sprite-Giovanna_Grana.png","w":24,"h":24,"r":"character:giovanna-grana"}," ",{"t":"Giovanna Grana","r":"character:giovanna-grana"}," and ",{"i":"Sprite-Zi'Assunta_Belpaese.png","w":24,"h":24,"r":"character:zi-assunta-belpaese"}," ",{"t":"Zi'Assunta Belpaese","r":"character:zi-assunta-belpaese"}," can make amazing use of it."]}]}},{"c":[{"i":"Sprite-Gatti_Amari.png","w":24,"h":24,"r":"weapon:gatti-amari"}," ",{"t":"Gatti Amari","r":"weapon:gatti-amari"}," loses its ability to create cat fight clouds when affected by this Arcana, reducing its effectiveness, however, it also nullifies the risk of self-damage from this weapon."]}]}],"subs":[]},{"id":"update-history","title":"Update history","blocks":[{"k":"p","c":["This information has been manually compiled. Some updates may not be included yet."]},{"k":"ul","items":[{"c":["hotfix 31 October 2025 (Update):"],"sub":{"k":"ul","items":[{"c":["Removed rogue evo weapon from Pale Diamond Incursion's description"]}]}}]},{"k":"ul","items":[{"c":["update 28 October 2025 (Update):"],"sub":{"k":"ul","items":[{"c":["Added to game."]}]}}]},{"k":"ul","items":[{"c":["beta ",{"i":"Steam_logo.svg","w":16,"h":16,"a":"Steam"}," 4 August 2025 (Update):"],"sub":{"k":"ul","items":[{"c":["Released in beta version."]}]}}]}],"subs":[]},{"id":"trivia","title":"Trivia","blocks":[{"k":"ul","items":[{"c":["The name of this Darkana is a reference to the song \"",{"t":"Pitch Black Intrusion","x":"https://castlevania.fandom.com/wiki/Pitch_Black_Intrusion"},"\", which is the theme song for ",{"t":"The Lost Village","x":"https://castlevania.fandom.com/wiki/The_Lost_Village"}," in ",{"t":"Castlevania: Dawn of Sorrow","x":"https://castlevania.fandom.com/wiki/Castlevania:_Dawn_of_Sorrow"},"."]},{"c":["Pale Diamond Incursion (V) can be unlocked in the ",{"i":"Sprite-Forbidden_Scrolls_of_Morbane.png","w":16,"h":16,"r":"relic:forbidden-scrolls-of-morbane"}," ",{"t":"Forbidden Scrolls of Morbane","r":"relic:forbidden-scrolls-of-morbane"}," by casting the spell \"apapli\", the reverse of \"ilpapa\" or \"the pope\" in Italian."],"sub":{"k":"ul","items":[{"c":["This makes Pale Diamond Incursion (V) a representation of ",{"t":"The Hierophant","x":"https://en.wikipedia.org/wiki/The_Hierophant"}," Major Arcana card in reverse position, symbolizing unpredictability, challenging the status quo, and rebellion."],"sub":{"k":"ul","items":[{"c":["However, its ability to change the direction of usually unpredictable projectiles in more desirable ways is closer to the Hierophant in upright position, symbolizing conformity, righteousness, preservation, and tradition."]}]}}]}}]}],"subs":[]}]}