{"ref":"character:yoko-belnades","lead":[{"k":"p","c":[{"i":"Animated-Alucard.gif","w":40,"h":34}]},{"k":"p","c":["DLC Content (Ode to Castlevania)"]},{"k":"p","c":["This article primarily features content only available in DLC, which may not be available in all copies of the game."]},{"k":"p","c":["Yoko Belnades is a playable character from the Ode to Castlevania DLC of Vampire Survivors. Her starting weapon is the ",{"i":"Sprite-Fulgur.png","w":21,"h":24,"r":"weapon:fulgur"}," ",{"t":"Fulgur","r":"weapon:fulgur"},". Upon unlocking the ",{"i":"Sprite-Belnades'_Spellbook.png","w":24,"h":24,"r":"weapon:belnades-spellbook"}," ",{"t":"Belnades' Spellbook","r":"weapon:belnades-spellbook"},", she can choose to start with this weapon selection as an alternative starting weapon via ",{"i":"Sprite-Mindbender.png","w":24,"h":24,"r":"relic:mindbender"}," ",{"t":"skin selection","r":"relic:mindbender"},"."]}],"infobox":[{"title":"Character","rows":[{"label":"Release","cells":[["31 October 2024 (Update)"]]},{"label":"Alias","cells":[["Yoko"]]},{"label":"Character ID","cells":[["TP_YOKO"]]},{"label":"Skin ID","cells":[["DEFAULT"]]},{"label":"Controller","cells":[["TP_Yoko_Character"]]},{"label":"Starting weapon","cells":[[{"i":"Sprite-Fulgur.png","w":14,"h":16,"r":"weapon:fulgur"}," ",{"t":"Fulgur","r":"weapon:fulgur"}]]},{"label":"Unlocked by","cells":[["Defeat Abaddon with ",{"t":"Soma Cruz","r":"character:soma-cruz"},"."]]},{"label":"Cost","cells":[[{"i":"Sprite-Gold_Coin.png","w":10,"h":10}," 1,665"]]},{"label":"Secret","cells":[["No"]]},{"label":"Ignores walls","cells":[["No"]]},{"label":"Theme","cells":[[{"i":"Music-Ode_to_Castlevania-Filippo_Vicarelli.png","w":20,"h":20}," \"Dracula's Tears - Vampire Survivors\""]]}]},{"title":"Initial stats","rows":[{"label":"Max Health","cells":[["100"]]},{"label":"Move Speed","cells":[["+40%"]]},{"label":"Speed","cells":[["+40%"]]},{"label":"Magnet","cells":[["+50%"]]},{"label":"Reroll","cells":[["+10"]]},{"label":"Skip","cells":[["+10