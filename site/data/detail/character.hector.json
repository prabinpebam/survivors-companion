{"ref":"character:hector","lead":[{"k":"p","c":[{"i":"Animated-Alucard.gif","w":40,"h":34}]},{"k":"p","c":["DLC Content (Ode to Castlevania)"]},{"k":"p","c":["This article primarily features content only available in DLC, which may not be available in all copies of the game."]},{"k":"p","c":["Hector is a playable character from the Ode to Castlevania DLC of Vampire Survivors. His starting weapon is ",{"i":"Sprite-Mace.png","w":24,"h":24,"r":"weapon:mace"}," ",{"t":"Mace","r":"weapon:mace"},". He is also eligible to pick ",{"i":"Sprite-Coat_of_Arms.png","w":24,"h":24,"r":"weapon:coat-of-arms"}," ",{"t":"Coat of Arms","r":"weapon:coat-of-arms"}," or ",{"i":"Sprite-Spectral_Sword.png","w":24,"h":24,"r":"weapon:spectral-sword"}," ",{"t":"Spectral Sword","r":"weapon:spectral-sword"}," as an alternate starting weapon via ",{"i":"Sprite-Mindbender.png","w":24,"h":24,"r":"relic:mindbender"}," ",{"t":"skin selection","r":"relic:mindbender"},"."]}],"infobox":[{"title":"Character","rows":[{"label":"Release","cells":[["31 October 2024 (Update)"]]},{"label":"Character ID","cells":[["TP_HECTOR"]]},{"label":"Skin ID","cells":[["DEFAULT"]]},{"label":"Controller","cells":[["TP_Hector_Character"]]},{"label":"Starting weapon","cells":[[{"i":"Sprite-Mace.png","w":16,"h":16,"r":"weapon:mace"}," ",{"t":"Mace","r":"weapon:mace"}]]},{"label":"Unlocked by","cells":[["Find 7 Karma Coins after opening the Scorpion Gate."]]},{"label":"Cost","cells":[[{"i":"Sprite-Gold_Coin.png","w":10,"h":10}," 500"]]},{"label":"Secret","cells":[["No"]]},{"label":"Ignores walls","cells":[["No"]]},{"label":"Theme","cells":[[{"i":"Music-Ode_to_Castlevania-Keygen_Church.png","w":20,"h":20}," \"Abandoned Castle - Vampire Survivors\""]]}]},{"title":"Initial stats","rows":[{"label":"Max Health","cells":[["100"]]},{"label":"Magnet","cells":[["+25%"]]},{"label":"Growth","cells":[["+20%"]]},{"label":"Reroll","cells":[["+20"]]},{"label":"Skip","cells":[["+20"]]},{"label":"Banish","cells":[["+20"]]}]}],"sections":[{"id":