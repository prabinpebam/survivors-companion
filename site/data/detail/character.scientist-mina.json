Foscari.png","w":12,"h":12,"a":"This content requires the Tides of the Foscari DLC to access"},", ",{"i":"Sprite-Santa_Water.png","w":24,"h":24,"r":"weapon:santa-water"}," ",{"t":"Santa Water","r":"weapon:santa-water"},", ",{"i":"Sprite-Lightning_Ring.png","w":24,"h":24,"r":"weapon:lightning-ring"}," ",{"t":"Lightning Ring","r":"weapon:lightning-ring"},", and so on."]},{"c":["Potentially having the highest scaling ",{"i":"Sprite-Speed.png","w":24,"h":24,"r":"powerup:speed"}," ",{"t":"Speed","r":"powerup:speed"},", Scientist can make particularly good use of ",{"i":"Sprite-SpellString.png","w":12,"h":14,"r":"weapon:spellstring"}," ",{"t":"SpellString","r":"weapon:spellstring"}," ",{"i":"Sprite-DLCBadge-TidesOfTheFoscari.png","w":12,"h":12,"a":"This content requires the Tides of the Foscari DLC to access"},", ",{"i":"Sprite-King_Bible.png","w":24,"h":24,"r":"weapon:king-bible"}," ",{"t":"King Bible","r":"weapon:king-bible"},", ",{"i":"Sprite-Runetracer.png","w":17,"h":17,"r":"weapon:runetracer"}," ",{"t":"Runetracer","r":"weapon:runetracer"},", and so on."]},{"c":["Potentially having the highest scaling ",{"i":"Sprite-Duration.png","w":24,"h":24,"r":"powerup:duration"}," ",{"t":"Duration","r":"powerup:duration"},", Scientist can make particularly good use of ",{"t":"Runetracer","r":"weapon:runetracer"},", ",{"i":"Sprite-Bone.png","w":24,"h":24,"r":"weapon:bone"}," ",{"t":"Bone","r":"weapon:bone"},", ",{"i":"Sprite-La_Robba.png","w":24,"h":24,"r":"weapon:la-robba"}," ",{"t":"La Robba","r":"weapon:la-robba"},", and so on."]},{"c":["Potentially having the highest scaling ",{"i":"Sprite-Luck.png","w":24,"h":24,"r":"powerup:luck"}," ",{"t":"Luck","r":"powerup:luck"},", Scientist may be able to make good use of ",{"i":"Sprite-Gatti_Amari.png","w":24,"h":24,"r":"weapon:gatti-amari"}," ",{"t":"Gatti Amari","r":"weapon:gatti-amari"},", ",{"i":"Sprite-Muramasa.png","w":24,"h":24,"r":"weapon:muramasa"}," ",{"t":"Muramasa","r":"weapon:muramasa"}," ",{"i":"Sprite-DLCBadge-LegacyOf