,"w":23,"h":24,"r":"character:barlowe"}," ",{"t":"Barlowe","r":"character:barlowe"}," starts with +200 Max Health."]},{"c":[{"i":"Sprite-Megalo_Elizabeth_Bartley.png","w":24,"h":19,"r":"character:megalo-elizabeth-bartley"}," ",{"t":"Megalo Elizabeth","r":"character:megalo-elizabeth-bartley"},", ",{"i":"Sprite-Megalo_Olrox.png","w":24,"h":24,"r":"character:megalo-olrox"}," ",{"t":"Megalo Olrox","r":"character:megalo-olrox"}," and ",{"i":"Sprite-Megalo_Death.png","w":22,"h":24,"r":"character:megalo-death"}," ",{"t":"Megalo Death","r":"character:megalo-death"}," start with +300 Max Health."]},{"c":[{"i":"Sprite-Vlad_Tepes_Dracula.png","w":24,"h":20,"r":"character:vlad-tepes-dracula"}," ",{"t":"Dracula","r":"character:vlad-tepes-dracula"}," and ",{"i":"Sprite-Megalo_Dracula.png","w":24,"h":12,"r":"character:megalo-dracula"}," ",{"t":"Megalo Dracula","r":"character:megalo-dracula"}," start with +566 Max Health."]},{"c":[{"i":"Sprite-Leon_Belmont.png","w":24,"h":24,"r":"character:leon-belmont"}," ",{"t":"Leon","r":"character:leon-belmont"}," starts with +20 Max Health and gains another +80 Max Health upon obtaining the ",{"i":"Sprite-Vampire_Killer.png","w":24,"h":24,"r":"weapon:vampire-killer"}," ",{"t":"Vampire Killer","r":"weapon:vampire-killer"},"."]},{"c":[{"i":"Sprite-Chaos.png","w":24,"h":24,"r":"character:chaos"}," ",{"t":"Chaos","r":"character:chaos"}," starts with +2097052 Max Health."]},{"c":[{"i":"Sprite-Fleaman.png","w":24,"h":24,"r":"character:fleaman"}," ",{"t":"Fleaman","r":"character:fleaman"}," starts with -99 Max Health."]}]}]}]},{"id":"notes","title":"Notes","blocks":[{"k":"ul","items":[{"c":["Max Health value shown in the Character Selection menu doesn't increase exponentially, which is incorrect."]},{"c":["Max Health value shown in the stats panel, both in the Character Selection menu and in-game, is rounded to the closest whole number. The actual value of Max Health is a decimal number."]},{"c":["Negative Max Health makes the character invulnerable."]},{"c":[{"i":"Sprite-White_Hand.png","w":15,"h":16}," White Hand kills the character by setting Max Health to 0 (even if Max Health is set to be negative)."]}]}],"subs":[]},{"id":"tips","title":"Tips","blocks":[{"k":"ul","items":[{"c":["Max Health bonuses are simultaneously more useful and less useful for characters that have less Max Health: The Hollow Heart provides them with especially-important survivability, but it will not scale as fast or as high as other characters. On the opposite side, Max Health Bonuses are especially potent while playing as ",{"i":"Sprite-Suor_Clerici.png","w":24,"h":24,"r":"character:suor-clerici"}," ",{"t":"Clerici","r":"character:suor-clerici"},"."]}]}],"subs":[]},{"id":"update-history","title":"Update history","blocks":[{"k":"p","c":["This information has been manually compiled. Some updates may not be included yet."]},{"k":"ul","items":[{"c":["update 27 October 2021 (Update):"],"sub":{"k":"ul","items":[{"c":["Added to game."]}]}}]}],"subs":[]},{"id":"trivia","title":"Trivia","blocks":[{"k":"ul","items":[{"c":["A recurring spelling error in the descriptions of some items is Max Health being spelled as \"MaxHealth.\" This typo can be found in the descriptions of the ",{"i":"Sprite-Crystal_Cries_(XII).png","w":17,"h":24,"r":"arcana:crystal-cries-xii"}," ",{"t":"Crystal Cries (XII)","r":"arcana:crystal-cries-xii"}," arcana and arcana pickups, such as the ",{"i":"Sprite-Cursed_Soul.png","w":24,"h":23}," Cursed Soul or the ",{"i":"Sprite-Crystallized_Soul.png","w":24,"h":23}," Crystallized Soul."]}]}],"subs":[]}]}