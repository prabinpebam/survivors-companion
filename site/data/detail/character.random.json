"]},{"c":["1"]},{"c":["1"]}]},{"cells":[{"c":[{"i":"Sprite-Growth.png","w":24,"h":24,"r":"powerup:growth"}," ",{"t":"Growth","r":"powerup:growth"}]},{"c":["0.01*(x−0.1)*y"]},{"c":["1"]},{"c":["1"]},{"c":["1"]},{"c":["1"]},{"c":["1"]},{"c":["1"]},{"c":["1"]},{"c":["1"]}]},{"cells":[{"c":[{"i":"Sprite-Greed.png","w":24,"h":20,"r":"powerup:greed"}," ",{"t":"Greed","r":"powerup:greed"}]},{"c":["0.01*(x−0.1)*y"]},{"c":["1"]},{"c":["1"]},{"c":["1"]},{"c":["1"]},{"c":["1"]},{"c":["1"]},{"c":["1"]},{"c":["1"]}]},{"cells":[{"c":[{"i":"Sprite-Curse.png","w":22,"h":24,"r":"powerup:curse"}," ",{"t":"Curse","r":"powerup:curse"}]},{"c":["0.01*(x−0.25)*y"]},{"c":["1"]},{"c":["1"]},{"c":["0.5"]},{"c":["1"]},{"c":["1"]},{"c":["1.5"]},{"c":["1"]},{"c":["1"]}]}]}]},{"id":"passive-bonuses-oscillating-stats","title":"Oscillating Stats","blocks":[{"k":"p","c":["Each level up changes the value of the maximum and minimum value of the oscillating multiplier and how long the cycle lasts. The maximum and minimum value both use the formula 2 * (0.1 + x) * y, ranging from 0.2 * y to 2.2 * y; the timer uses 60 * (0.1 + x), ranging from 6 seconds to 66 seconds. All five possible stats that can oscillate (",{"i":"Sprite-Might.png","w":18,"h":24,"r":"powerup:might"}," ",{"t":"Might","r":"powerup:might"},", ",{"i":"Sprite-Speed.png","w":24,"h":24,"r":"powerup:speed"}," ",{"t":"Speed","r":"powerup:speed"},", ",{"i":"Sprite-Duration.png","w":24,"h":24,"r":"powerup:duration"}," ",{"t":"Duration","r":"powerup:duration"},", ",{"i":"Sprite-Area.png","w":22,"h":24,"r":"powerup:area"}," ",{"t":"Area","r":"powerup:area"},", and ",{"i":"Sprite-Cooldown.png","w":24,"h":24,"r":"powerup:cooldown"}," ",{"t":"Cooldown","r":"powerup:cooldown"},") share the same y value based on the character."]},{"k":"p","c":["Note: The \"maximum\" value can be lower than the \"minimum\", it just represents the character starts with that value first."]},{"k":"table","rows":[{"h":1,"cells":[{"c":[],"h":1},{"c":["Aren Gijus"],"h":1},{"c":["Titto"],"h":1},{"c":["Chalanda"],"h":1},{"c":["SHAtsung"],"h":1},{"c":["Marionello"],"h":1},{"c":["Birky"],"h":1},{"c":["Zylaz"],"h":1},{"c":["Mi Kujino"],"h":1}]},{"cells":[{"c":["Max"]},{"c":["1"]},{"c":["1"]},{"c":["1.5"]},{"c":["1"]},{"c":["0.5"]},{"c":["1"]},{"c":["1"]},{"c":["1"]}]},{"cells":[{"c":["Min"]},{"c":["1"]},{"c":["1.5"]},{"c":["1"]},{"c":["0.5"]},{"c":["1"]},{"c":["1"]},{"c":["1"]},{"c":["1"]}]}]}]}]},{"id":"tips","title":"Tips","blocks":[{"k":"ul","items":[{"c":["Any base weapon can appear on Random, including the individual guns ",{"t":"Phiera Der Tuphello","r":"weapon:phiera-der-tuphello"}," and ",{"t":"Eight The Sparrow","r":"weapon:eight-the-sparrow"},", as well as the non-damage-dealing weapons ",{"i":"Sprite-Clock_Lancet.png","w":24,"h":24,"r":"weapon:clock-lancet"}," ",{"t":"Clock Lancet","r":"weapon:clock-lancet"}," and ",{"i":"Sprite-Laurel.png","w":24,"h":24,"r":"weapon:laurel"}," ",{"t":"Laurel","r":"weapon:laurel"},". Random will not be granted a bonus level at the start to account for this."],"sub":{"k":"ul","items":[{"c":["The only way to solve this issue is to use Arcanas with offensive capability like ",{"t":"Heart of Fire (XIX)","r":"weapon:heart-of-fire-xix"},", ",{"t":"Sarabande of Healing (VI)","r":"weapon:sarabande-of-healing-vi"},", ",{"t":"Divine Bloodline (IX)","r":"weapon:divine-bloodline-ix"},", ",{"t":"Blood Astronomia (XXI)","r":"weapon:blood-astronomia-xxi"},", ",{"t":"Game Killer (0)","r":"weapon:game-killer-0"},", or ",{"t":"Out of Bounds (XII)","r":"weapon:out-of-bounds-xii"}," (Clock Lancet only)."]}]}},{"c":["Random does not benefit from the stat oscillation from ",{"t":"Chaos in the Dark Night (V)","r":"arcana:chaos-in-the-dark-night-v"},", ",{"t":"Boogaloo of Illusions (XVIII)","r":"arcana:boogaloo-of-illusions-xviii"},", and ",{"t":"Lost & Found Painting (XVII)","r":"arcana:lost-found-painting-xvii"}," as they require the character to not have value in the sineStat attributes to set their own value while the changing stats already occupied them. It does not override them either. However, it can still benefit from the additional stats every level."]}]}],"subs":[]},{"id":"notes","title":"Notes","blocks":[{"k":"ul","items":[{"c":["The random (re-)selection of Random's name and its starting base weapon will trigger upon re-entering the character selection menu (or in other words, either exiting from the character menu or the stage selection menu to the main menu and back to the character selection menu.)"]}]}],"subs":[]},{"id":"gallery","title":"Gallery","blocks":[{"k":"gallery","items":[{"i":"Sprite-Random.png","w":57,"h":90,"c":["Random's sprite"]},{"i":"Animated-Random.gif","w":69,"h":120,"c":["Movement animation"]}]}],"subs":[]},{"id":"update-history","title":"Update history","blocks":[{"k":"p","c":["This information has been manually compiled. Some updates may not be included yet."]},{"k":"ul","items":[{"c":["update 2 September 2022 (Update):"],"sub":{"k":"ul","items":[{"c":["Added to game."]}]}}]}],"subs":[]},{"id":"trivia","title":"Trivia","blocks":[{"k":"ul","items":[{"c":["Some of the names are references to things that involve randomness or characters that have shapeshifting or transformation abilities."],"sub":{"k":"ul","items":[{"c":["The name \"Aren Gijus\" is a play on ",{"t":"RNGesus","x":"https://en.wiktionary.org/wiki/RNGesus"},"."],"sub":{"k":"ul","items":[{"c":["This name, in particular, is chosen for Random's ID."]}]}},{"c":["The name \"Titto\" is likely referencing ",{"t":"Ditto","x":"https://bulbapedia.bulbagarden.net/wiki/Ditto_(Pok%C3%A9mon)"}," from the ",{"t":"Pokémon","x":"https://en.wikipedia.org/wiki/Pok%C3%A9mon"}," series, who can use the move ",{"t":"Transform","x":"https://bulbapedia.bulbagarden.net/wiki/Transform_(move)"}," to turn into an opposing Pokémon."]},{"c":["The name \"SHAtsung\" is likely referencing ",{"t":"Shang Tsung","x":"https://en.wikipedia.org/wiki/Shang_Tsung"}," from the ",{"t":"Mortal Kombat","x":"https://en.wikipedia.org/wiki/Mortal_Kombat"}," series, a shapeshifting sorcerer who can turn into other Mortal Kombat \"kombatants\" (combatants), and the ",{"t":"Secure Hash Algorithms","x":"https://en.wikipedia.org/wiki/Secure_Hash_Algorithms"}," (SHA), which generate a nearly-random, nearly-unique number for a given digital input."]},{"c":["The name \"Birky\" is likely referencing ",{"t":"Kirby","x":"https://en.wikipedia.org/wiki/Kirby_(character)"}," from the ",{"t":"series of the same name","x":"https://en.wikipedia.org/wiki/Kirby_(series)"},", who can inhale creatures and then copy their abilities."]},{"c":["The name \"Zylaz\" is an anagram of \"Alias\" with some letters replaced with homophones."]},{"c":["The name \"Mi Kujino\" is an anagram of ",{"t":"Mokujin","x":"https://tekken.fandom.com/wiki/Mokujin"},", a character from Bandai Namco's fighting game series ",{"t":"Tekken","x":"https://en.wikipedia.org/wiki/Tekken"},", a wooden dummy that mimics the movesets of most characters in the game, with some exceptions or minor changes depending on the specific game (such as wings when mimicking Angel or Devil, or the weapon wielded as Yoshimitsu or Kunimitsu). The name is also a play on words on the Italian \"Mio Cugino\", meaning \"My Cousin\"."]},{"c":["The spell cast to unlock Random (igottagettotheedgeofsoul) is taken from the lyrics in the opening-trailer of Soul Edge, another fighting-game franchise by Bandai Namco."]}]}},{"c":["In the Results screen, Random's name will simply appear as \"Random\" instead of any of the random names that are chosen for it."]}]}],"subs":[]}]}