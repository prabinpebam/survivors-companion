c":["Imelda as depicted in the main menu of the adventure \"World of Light and Dark.\""]},{"i":"Vampire_Survivors_1_-_comic_book_cover.jpg","w":99,"h":150,"c":["Imelda in the main cover of the first issue of the Vampire Survivors comic book series."]}]}]}]},{"id":"update-history","title":"Update history","blocks":[{"k":"p","c":["This information has been manually compiled. Some updates may not be included yet."]},{"k":"ul","items":[{"c":["update 9 June 2022 (Update):"],"sub":{"k":"ul","items":[{"c":["Default skin added to game."]}]}}]},{"k":"ul","items":[{"c":["update 12 December 2021 (Update):"],"sub":{"k":"ul","items":[{"c":["Added walking animation for Imelda."]}]}}]},{"k":"ul","items":[{"c":["update 27 October 2021 (Update):"],"sub":{"k":"ul","items":[{"c":["Added to game."]}]}}]}],"subs":[]},{"id":"trivia","title":"Trivia","blocks":[{"k":"ul","items":[{"c":["Aside from ",{"i":"Sprite-Antonio_Belpaese.png","w":24,"h":24,"r":"character:antonio-belpaese"}," ",{"t":"Antonio","r":"character:antonio-belpaese"}," and ",{"i":"Sprite-Queen_Sigma.png","w":24,"h":24,"r":"character:queen-sigma"}," ",{"t":"Queen Sigma","r":"character:queen-sigma"},", who are free, she is the cheapest character in the game."]},{"c":["Imelda's family name, Belpaese, is derived from the phrase Bel Paese, which is Italian for \"beautiful country\", and also refers to a semi-soft Italian cheese with the same name."]},{"c":["Her height is 168cm."]},{"c":["Imelda, ",{"i":"Sprite-Mortaccio.png","w":24,"h":24,"r":"character:mortaccio"}," ",{"t":"Mortaccio","r":"character:mortaccio"},", ",{"i":"Sprite-Yatta_Cavallo.png","w":24,"h":24,"r":"character:yatta-cavallo"}," ",{"t":"Cavallo","r":"character:yatta-cavallo"},", ",{"i":"Sprite-Bianca_Ramba.png","w":24,"h":24,"r":"character:bianca-ramba"}," ",{"t":"Ramba","r":"character:bianca-ramba"},", and ",{"i":"Sprite-O'Sole_Meeo.png","w":24,"h":24,"r":"character:o-sole-meeo"}," ",{"t":"O'Sole","r":"character:o-sole-meeo"}," are the only characters whose starting stats are all base stats."]}]}],"subs":[{"id":"trivia-in-other-media","title":"In other media","blocks":[{"k":"ul","items":[{"c":["Imelda Belpaese makes an appearance in the idle farming simulation game ",{"t":"Rusty's Retirement","x":"https://rustys-retirement.fandom.com/wiki/Rusty%27s_Retirement"},", as part of that game's update that includes Vampire Survivors content. She is a reskin of ",{"t":"Forbic","x":"https://rustys-retirement.fandom.com/wiki/Forbic"}," in that game."]}]}]}]}]}