{"ref":"character:blue-crescent-moon-cornell","lead":[{"k":"p","c":[{"i":"Animated-Alucard.gif","w":40,"h":34}]},{"k":"p","c":["DLC Content (Ode to Castlevania)"]},{"k":"p","c":["This article primarily features content only available in DLC, which may not be available in all copies of the game."]},{"k":"p","c":["Blue Crescent Moon Cornell is a secret playable character from the Ode to Castlevania DLC of Vampire Survivors. His starting weapon is ",{"i":"Sprite-Trinum_Custodem.png","w":24,"h":24,"r":"weapon:trinum-custodem"}," ",{"t":"Trinum Custodem","r":"weapon:trinum-custodem"},", but he also has the option of starting with the ",{"i":"Sprite-Ebony_Diabologue.png","w":24,"h":24,"r":"weapon:ebony-diabologue"}," ",{"t":"Ebony Diabologue","r":"weapon:ebony-diabologue"}," if it has been unlocked."]}],"infobox":[{"title":"Character","rows":[{"label":"Release","cells":[["31 October 2024 (Update)"]]},{"label":"Alias","cells":[["Cornell"]]},{"label":"Character ID","cells":[["TP_CORNELL_BCM"]]},{"label":"Skin ID","cells":[["DEFAULT"]]},{"label":"Controller","cells":[["TP_Cornell_BCM_Character"]]},{"label":"Starting weapon","cells":[[{"i":"Sprite-Trinum_Custodem.png","w":16,"h":16,"r":"weapon:trinum-custodem"}," ",{"t":"Trinum Custodem","r":"weapon:trinum-custodem"}]]},{"label":"Unlocked by","cells":[["Slay the castle's denizens under the Blue Crescent Moon to make him a beast."]]},{"label":"Cost","cells":[[{"i":"Sprite-Gold_Coin.png","w":10,"h":10}," 9,000"]]},{"label":"Secret","cells":[["Yes"]]},{"label":"Ignores walls","cells":[["No"]]},{"label":"Theme","cells":[[{"i":"Music-Ode_to_Castlevania-Castlevania_Harmony_of_Despair.png","w":20,"h":20}," Pitiful Scion (\"Tragic Prince)\""]]}]},{"title":"Initial stats","rows":[{"label":"Max Health","cells":[["200"]]},{"label":"Armor","cells":[["+2"]]},{"label":"Move Speed","cells":[["+40%"]]},{"label":"Amount","cells":[["+3"]]},{"label":"Reroll","cells":[["+10"]]}]}],"sections":[{"id":"unlocking","title":"Unlocking","blocks":[{"k":