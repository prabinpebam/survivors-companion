cent_Dorin.png","w":97,"h":120,"c":["Vincent Dorin's sprite"]},{"i":"Animated-Vincent_Dorin.gif","w":105,"h":120,"c":["Movement animation"]}]}],"subs":[]},{"id":"update-history","title":"Update history","blocks":[{"k":"p","c":["This information has been manually compiled. Some updates may not be included yet."]},{"k":"ul","items":[{"c":["update 31 October 2024 (Update):"],"sub":{"k":"ul","items":[{"c":["Added to game."]}]}}]}],"subs":[]},{"id":"external-links","title":"External links","blocks":[{"k":"ul","items":[{"c":[{"t":"Vincent Dorin","x":"https://castlevania.fandom.com/wiki/Vincent_Dorin"}," in the ",{"t":" Castlevania Wiki","x":"https://castlevania.fandom.com/"}]}]}],"subs":[]}]}