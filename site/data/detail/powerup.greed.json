":19,"h":24,"r":"character:loretta-lecarde"}," ",{"t":"Loretta","r":"character:loretta-lecarde"},", ",{"i":"Sprite-Brauner.png","w":19,"h":24,"r":"character:brauner"}," ",{"t":"Brauner","r":"character:brauner"},", ",{"i":"Sprite-Graham_Jones.png","w":17,"h":24,"r":"character:graham-jones"}," ",{"t":"Graham","r":"character:graham-jones"},", ",{"i":"Sprite-Walter_Bernhard.png","w":22,"h":24,"r":"character:walter-bernhard"}," ",{"t":"Walter","r":"character:walter-bernhard"},", ",{"i":"Sprite-Carmilla.png","w":16,"h":24,"r":"character:carmilla"}," ",{"t":"Carmilla","r":"character:carmilla"},", ",{"i":"Sprite-Count_Olrox.png","w":14,"h":24,"r":"character:count-olrox"}," ",{"t":"Olrox","r":"character:count-olrox"},", ",{"i":"Sprite-Succubus.png","w":17,"h":24,"r":"character:succubus"}," ",{"t":"Succubus","r":"character:succubus"},", ",{"i":"Sprite-Galamoth.png","w":24,"h":21,"r":"character:galamoth"}," ",{"t":"Galamoth","r":"character:galamoth"},", ",{"i":"Sprite-Megalo_Elizabeth_Bartley.png","w":24,"h":19,"r":"character:megalo-elizabeth-bartley"}," ",{"t":"Megalo Elizabeth","r":"character:megalo-elizabeth-bartley"},", ",{"i":"Sprite-Megalo_Olrox.png","w":24,"h":24,"r":"character:megalo-olrox"}," ",{"t":"Megalo Olrox","r":"character:megalo-olrox"},", ",{"i":"Sprite-Megalo_Death.png","w":22,"h":24,"r":"character:megalo-death"}," ",{"t":"Megalo Death","r":"character:megalo-death"}," and ",{"i":"Sprite-Megalo_Dracula.png","w":24,"h":12,"r":"character:megalo-dracula"}," ",{"t":"Megalo Dracula","r":"character:megalo-dracula"}," start with +100% Greed."]},{"c":[{"i":"Sprite-Master_Librarian.png","w":24,"h":23,"r":"character:master-librarian"}," ",{"t":"Master Librarian","r":"character:master-librarian"}," starts with +1000% Greed."]},{"c":[{"i":"Sprite-Vincent_Dorin.png","w":19,"h":24,"r":"character:vincent-dorin"}," ",{"t":"Vincent","r":"character:vincent-dorin"}," starts with +20% Greed and gains Greed when overhealing, with diminishing returns. His Greed is also doubled while invulnerable."]},{"c":[{"i":"Sprite-Joachim_Armster.png","w":17,"h":24,"r":"character:joachim-armster"}," ",{"t":"Joachim","r":"character:joachim-armster"}," starts with +100% Greed and can select to gain +1% Greed per level."]},{"c":[{"i":"Sprite-Blackmore.png","w":19,"h":24,"r":"character:blackmore"}," ",{"t":"Blackmore","r":"character:blackmore"}," starts with +100% Greed and can select to gain +1% Greed per level after defeating 1000, 5000, 9000, 13000 and 17000 enemies, for a maximum of up to +5% Greed per level."]}]}]}]},{"id":"from-stages","title":"From stages","blocks":[],"subs":[{"id":"from-stages-base-game","title":"Base Game","blocks":[{"k":"ul","items":[{"c":[{"t":"Dairy Plant","r":"stage:dairy-plant"}," multiply gold gain by 1.2."]},{"c":[{"t":"Gallo Tower","r":"stage:gallo-tower"},", ",{"t":"Bat Country","r":"stage:bat-country"},", and ",{"t":"Tiny Bridge","r":"stage:tiny-bridge"}," multiply gold gain by 1.3."]},{"c":[{"t":"Cappella Magna","r":"stage:cappella-magna"}," multiply gold gain by 1.4."]},{"c":[{"t":"The Bone Zone","r":"stage:the-bone-zone"}," multiply gold gain by 1.5."]}]}]},{"id":"from-stages-legacy-of-the-moonspell","title":"Legacy of the Moonspell","blocks":[{"k":"ul","items":[{"c":[{"t":"Mt.Moonspell","r":"stage:mt-moonspell"}," multiply gold gain by 1.5."]}]},{"k":"p","c":["The hyper modes of all stages, except ",{"t":"Holy Forbidden","r":"stage:holy-forbidden"}," and Eudaimonia Machine, give a +50% gold gain bonus additively."]},{"k":"p","c":["The inverse modes of all stages, except Holy Forbidden and Eudaimonia Machine, give a +200% gold gain bonus additively."]}]}]},{"id":"tips","title":"Tips","blocks":[{"k":"ul","items":[{"c":["Greed is not vital for winning a run, but rather getting the most money out of it. If you find yourself unable to finish a run, it is advised to invest into other passives and PowerUps over taking the Stone Mask or ranking up the Greed PowerUp."]},{"c":["Bonuses to Greed apply additively. For example, 50% Greed makes ",{"i":"Sprite-Rich_Coin_Bag.png","w":24,"h":24}," Rich Coin Bags give 150 coins instead of 100. Stage bonuses, however, do not count as Greed, but are an additional multiplier. The +50% Gold bonus from ",{"t":"Mad Forest","r":"stage:mad-forest"},"'s hyper mode would increase the 150 coins from previous example to 225."],"sub":{"k":"ul","items":[{"c":["For the highest gold multiplier, you need the level 5 Stone Mask (+50%) and the Greed PowerUps (+50%) for a total of +100% Gold earning, and play ",{"t":"The Bone Zone","r":"stage:the-bone-zone"}," in hyper mode multiplying overall gold gain by 2x to total of 4x the original amount."]}]}}]}],"subs":[]},{"id":"update-history","title":"Update history","blocks":[{"k":"p","c":["This information has been manually compiled. Some updates may not be included yet."]},{"k":"ul","items":[{"c":["update 2 January 2022 (Update):"],"sub":{"k":"ul","items":[{"c":["Added to game."]}]}}]}],"subs":[]}]}