]},{"c":["Showstopper can be triggered again once restored to full health."]}]}],"subs":[]},{"id":"tips","title":"Tips","blocks":[{"k":"ul","items":[{"c":["The cats will spawn out of bounds, making levels with narrow passages like ",{"t":"Inlaid Library","r":"stage:inlaid-library"}," less effective at stat gains, however, due to how cats are dragged towards you while out of bounds it is possible to farm them very easily with a large enough magnet radius and large amounts of surrounding out of bounds space."]}]}],"subs":[]},{"id":"trivia","title":"Trivia","blocks":[{"k":"ul","items":[{"c":["Her unlocking spell is a reference to her human identity in SaGa Emerald Beyond, an 11-year-old schoolgirl named Yumeha Izumi."]}]}],"subs":[]},{"id":"gallery","title":"Gallery","blocks":[],"subs":[{"id":"gallery-sprites","title":"Sprites","blocks":[{"k":"gallery","items":[{"i":"Sprite-Ameya_Aisling.png","w":120,"h":116,"c":["Ameya Aisling's sprite"]},{"i":"Animated-Ameya_Aisling.gif","w":120,"h":111,"c":["Movement animation"]},{"i":"Sprite-Lolo,_Hiss,_Meow,_and_Purr_(black).png","w":120,"h":80,"c":["Black Cat"]},{"i":"Sprite-Lolo,_Hiss,_Meow,_and_Purr_(white).png","w":120,"h":80,"c":["White Cat"]},{"i":"Sprite-Lolo,_Hiss,_Meow,_and_Purr_(yellow).png","w":120,"h":80,"c":["Yellow Cat"]},{"i":"Sprite-Lolo,_Hiss,_Meow,_and_Purr_(red).png","w":120,"h":80,"c":["Red Cat"]},{"i":"Sprite-Lolo,_Hiss,_Meow,_and_Purr_(blue).png","w":120,"h":80,"c":["Blue Cat"]},{"i":"Animated-Lolo,_Hiss,_Meow,_and_Purr_(rainbow).gif","w":120,"h":82,"c":["Rainbow Cat"]}]}]},{"id":"gallery-other","title":"Other","blocks":[{"k":"gallery","items":[{"i":"Ameya_Aisling_talking_to_Poe.png","w":200,"h":90,"c":["Ameya Aisling talking to ",{"i":"Sprite-Poe_Ratcho.png","w":24,"h":24,"r":"character:poe-ratcho"}," ",{"t":"Poe Ratcho","r":"character:poe-ratcho"}," in the video \"diorama di smeraldo sopravvissuti ai vampiri\"."]},{"i":"Ameya_Aisling_-_trailer.png","w":200,"h":116,"c":["Ameya Aisling as seen in the ",{"t":"